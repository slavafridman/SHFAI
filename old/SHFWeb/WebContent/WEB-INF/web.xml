<?xml version="1.0" encoding="UTF-8"?>
<web-app id="WebApp_ID" version="2.4" xmlns="http://java.sun.com/xml/ns/j2ee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-app_2_4.xsd">
	<display-name>SHFWeb</display-name>
	<listener>
    	<listener-class>bzq.shf.servletListeners.BaseServletListener</listener-class>	<!-- Must be first in the listeners list -->
	</listener>
	<context-param>
	    <param-name>appConfig</param-name>
	    <param-value>shf-config.xml</param-value>
	</context-param>
	<listener>
    	<listener-class>bzq.shf.servletListeners.BackgroundJobManager</listener-class>
	</listener>

	<servlet>
		<description>
		</description>
		<display-name>
		ActionServlet</display-name>
		<servlet-name>ActionServlet</servlet-name>
		<servlet-class>
		bzq.shf.action.ActionServlet</servlet-class>
		<init-param>
			<description>
			</description>
			<param-name>config</param-name>
			<param-value>/WEB-INF/struts-config.xml</param-value>
		</init-param>
		<init-param>
			<description>
			</description>
			<param-name>application</param-name>
			<param-value>shfResources</param-value>
		</init-param>
		<init-param>
			<description>
			</description>
			<param-name>appConfig</param-name>
			<param-value>shf-config.xml</param-value>
		</init-param>
		<init-param>
			<description>
			</description>
			<param-name>additionalAppConfig</param-name>
			<param-value>additional.xml</param-value>
		</init-param>
		<init-param>
			<description>
			</description>
			<param-name>factory</param-name>
			<param-value>bzq.utils.XMLMessageResourcesFactory</param-value>
		</init-param>
		<init-param>
			<description>
			</description>
			<param-name>debug</param-name>
			<param-value>2</param-value>
		</init-param>
		<init-param>
			<description>
			</description>
			<param-name>detail</param-name>
			<param-value>2</param-value>
		</init-param>
		<init-param>
			<description>
			</description>
			<param-name>validate</param-name>
			<param-value>true</param-value>
		</init-param>
		<init-param>
			<description>
			</description>
			<param-name>validating</param-name>
			<param-value>false</param-value>
		</init-param>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet>
		<description>
		</description>
		<display-name>
		BezeqValidatorServlet</display-name>
		<servlet-name>BezeqValidatorServlet</servlet-name>
		<servlet-class>
		bzq.action.BezeqValidatorServlet</servlet-class>
		<init-param>
			<description>
			</description>
			<param-name>config-rules</param-name>
			<param-value>/WEB-INF/validator-rules.xml</param-value>
		</init-param>
		<init-param>
			<description>
			</description>
			<param-name>config</param-name>
			<param-value>/WEB-INF/validation.xml</param-value>
		</init-param>
		<init-param>
			<description>
			</description>
			<param-name>debug</param-name>
			<param-value>2</param-value>
		</init-param>
		<load-on-startup>-1</load-on-startup>
	</servlet>
	
	<servlet-mapping>
		<servlet-name>ActionServlet</servlet-name>
		<url-pattern>*.do</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>BezeqValidatorServlet</servlet-name>
		<url-pattern>/bezeqValidate</url-pattern>
	</servlet-mapping>

	<welcome-file-list>
		<welcome-file>login.do</welcome-file>
	</welcome-file-list>
	<error-page>
		<error-code>400</error-code>
		<location>/jsp/fatal_error.jsp</location>
	</error-page>
	<error-page>
		<error-code>401</error-code>
		<location>/jsp/fatal_error.jsp</location>
	</error-page>
	<error-page>
		<error-code>404</error-code>
		<location>/jsp/fatal_error.jsp</location>
	</error-page>
	<error-page>
		<error-code>500</error-code>
		<location>/jsp/fatal_error.jsp</location>
	</error-page>
	<jsp-config>
		<taglib>
			<taglib-uri>/WEB-INF/bzq-html.tld</taglib-uri>
			<taglib-location>/WEB-INF/bzq-html.tld</taglib-location>
		</taglib>
		<taglib>
			<taglib-uri>/WEB-INF/struts-html.tld</taglib-uri>
			<taglib-location>/WEB-INF/struts-html.tld</taglib-location>
		</taglib>
		<taglib>
			<taglib-uri>/WEB-INF/shf-html.tld</taglib-uri>
			<taglib-location>/WEB-INF/shf-html.tld</taglib-location>
		</taglib>
		<taglib>
			<taglib-uri>/WEB-INF/bzq-js.tld</taglib-uri>
			<taglib-location>/WEB-INF/bzq-js.tld</taglib-location>
		</taglib>
		<taglib>
			<taglib-uri>/WEB-INF/struts-logic.tld</taglib-uri>
			<taglib-location>/WEB-INF/struts-logic.tld</taglib-location>
		</taglib>
		<taglib>
			<taglib-uri>/WEB-INF/struts-bean.tld</taglib-uri>
			<taglib-location>/WEB-INF/struts-bean.tld</taglib-location>
		</taglib>
	</jsp-config>
	
</web-app>
