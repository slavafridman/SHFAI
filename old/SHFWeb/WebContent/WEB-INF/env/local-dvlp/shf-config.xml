<?xml version="1.0" encoding="ISO-8859-1" ?>
<app-config>
 <logger>
	<logger-info name="WEB-INF/env/local-dvlp/log4j_shf.xml"
		watch="true"
		watchInterval="10000"/>
 </logger>
 <db-definitions>
