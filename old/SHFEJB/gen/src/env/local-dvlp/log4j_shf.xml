<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE log4j:configuration SYSTEM "../../../WEB-INF/log4j.dtd">

<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/">

	<renderer renderedClass="org.apache.struts.action.ActionErrors" renderingClass="bzq.log4j.ActionErrorsRenderer"/>
	
	<appender name="Console" class="org.apache.log4j.ConsoleAppender">
		<param name="Threshold" value="debug" />
		<layout class="org.apache.log4j.PatternLayout">
			<param name="ConversionPattern" value="%d{dd-MM-yyyy HH:mm:ss.SSS} [%x] %-5p %-20.20C{1} - %m\r\n"/>
		</layout>
	</appender>
	
	<category name="bzq" additivity="true">
		<priority value="info" />
	</category>
	
	<!-- Start Application -->
	
	<category name="shf" additivity="true">
		<priority value="info" />
	</category>
	
	<!-- End Application -->
	
	<root>
		<priority value="info"/>
		<appender-ref ref="Console"/>
	</root>

</log4j:configuration>