{
  "name": "@shf/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "start": "npm run build && node dist/main.js",
    "start:stub": "npm run build && node dist/main.js --stub",
    "oracle:check": "npm run build && node dist/oracle/check.js",
    "oracle:inspect-shifts": "npm run build && node dist/oracle/check.js --metadata"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "fastify": "5.12.5",
    "oracledb": "26.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/oracledb": "7.0.3",
    "typescript": "6.0.3"
  }
}
