{
  "name": "shifter",
  "version": "0.1.0",
  "private": true,
  "description": "SHF local application foundation; business capabilities are not connected.",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev:api": "npm start --workspace=@shf/api",
    "dev:api:stub": "npm run start:stub --workspace=@shf/api",
    "dev:web": "npm start --workspace=shf-web",
    "oracle:check": "npm run oracle:check --workspace=@shf/api",
    "oracle:inspect-shifts": "npm run oracle:inspect-shifts --workspace=@shf/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "lint": "eslint apps",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@angular/cli": "22.2.2",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.2"
  }
}
